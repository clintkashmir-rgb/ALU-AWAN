
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Allow all authenticated users to read/write sections (inventory)
    match /sections/{sectionId} {
      allow read, write: if isSignedIn();
    }

    // Allow all authenticated users to read/write invoices (orders)
    match /invoices/{invoiceId} {
      allow read, write: if isSignedIn();
      
      // Allow nested items and sections
      match /items/{itemId} {
        allow read, write: if isSignedIn();
        match /sections/{sectionItemId} {
          allow read, write: if isSignedIn();
        }
      }
    }
    
    // Legacy support for 'orders' collection if used
    match /orders/{orderId} {
      allow read, write: if isSignedIn();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
